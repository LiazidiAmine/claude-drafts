{
  "name": "nextjs-logger-pm2",
  "version": "1.0.0",
  "description": "Next.js with PM2-friendly logging",
  "scripts": {
    "dev": "next dev",
    "dev:pretty": "next dev 2>&1 | pino-pretty",
    "build": "next build",
    "start": "next start",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:logs:pretty": "pm2 logs --raw | pino-pretty",
    "pm2:monit": "pm2 monit",
    "demo": "./run-demo.sh",
    "demo:dev": "NODE_ENV=development node examples/object-logging-demo.js",
    "demo:prod": "NODE_ENV=production node examples/object-logging-demo.js"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "autoprefixer": "^10.4.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.554.0",
    "next": "^14.0.0",
    "pino": "^8.16.0",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "pino-pretty": "^10.2.0",
    "pm2": "^5.3.0",
    "typescript": "^5.3.0"
  }
}
